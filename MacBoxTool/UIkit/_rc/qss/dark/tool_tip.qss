ToolTip {
    border-radius: 999px;
}

ToolTip > #container {
    background-color: rgb(43, 43, 43);
    border: 1px solid rgb(70, 70, 70);
    border-radius: 999px;
}

ToolTip>#container[transparent=true] {
    background-color: transparent;
    border: 1px solid rgba(0, 0, 0, 50);
}

QLabel {
    background-color: transparent;
    font: 12px --FontFamilies;
    color: white;
    border: none;
}
